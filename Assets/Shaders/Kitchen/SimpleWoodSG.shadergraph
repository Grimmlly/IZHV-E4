    "m_SourceType": 1,
    "m_FunctionName": "Contour",
    "m_FunctionSource": "",
    "m_FunctionBody": "float scale = 10.0;\r\nA *= scale;\r\nOut = smoothstep(0.0, \r\n    0.5 + B * 0.5, \r\n    abs(sin(A * 3.141)  + B * 2.0) *  0.5\r\n);"
}

